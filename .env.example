# ==============================================================================
# ImmoLead Website — Environment Configuration
# ==============================================================================

# Server Port (optional, defaults to 3000)
PORT=3000

# Node Environment (development or production)
NODE_ENV=production

# ------------------------------------------------------------------------------
# Gmail SMTP Configuration (used by api/audit.js via Nodemailer)
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (spaces are stripped automatically)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_account@gmail.com
SMTP_PASS=your_16_character_app_password

# The sender address shown to recipients. Gmail requires this to be the
# authenticated account above (or a verified alias of it).
FROM_EMAIL=ImmoLead Website <your_account@gmail.com>

# ------------------------------------------------------------------------------
# Notification Recipients (Both emails receive identical lead submissions)
# ------------------------------------------------------------------------------
NOTIFICATION_RECIPIENTS=muhammadnawaz9626@gmail.com, immoleadlu@gmail.com
